# TailaBot - RemoteCoding — variáveis de exemplo (NUNCA valores reais aqui)

# Token do bot criado no @BotFather (cole no seu .env local, não aqui)
BOT_TOKEN=DIGITE_SEU_BOT_TOKEN_AQUI

# Seu identificador numérico no Telegram (allowlist — só esse chat comanda o TailaBot)
# Descubra com @userinfobot ou pela primeira mensagem enviada ao bot.
OWNER_CHAT_ID=DIGITE_SEU_CHAT_ID_AQUI

# Servidor opencode que o bot já encontra rodando (rode: opencode serve --port 4590)
OPENCODE_SERVE_PORT=4590
OPENCODE_BASE_URL=http://127.0.0.1:4590

# Diretório-raiz onde o opencode roda os projetos (ex.: pasta "AAA digital PROJECT")
WORK_ROOT=C:\Users\SEU_USUARIO\Documents\AAA digital PROJECT

# Idioma padrão das respostas (pt | en)
LANG=pt

# (Opcional) Timeout máximo por tarefa, em segundos
TASK_TIMEOUT_SECS=600

# (Opcional) Caminho do projeto Loja BlackOps7 local (botão → Resumo)
LOJA_PATH=C:\xampp\htdocs\blackops7

# (Opcional) Formato de resposta das mensagens: text | markdown | html
MSG_FORMAT=text